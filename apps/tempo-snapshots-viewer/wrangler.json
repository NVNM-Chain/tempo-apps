{
	"$schema": "https://esm.sh/wrangler/config-schema.json",
	"name": "nvnm-snapshots-viewer",
	"main": "./src/index.ts",
	"compatibility_date": "2025-12-17",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"keep_vars": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	},
	"env": {
		"testnet": {
			"account_id": "2ff8e4962cfd414617e13d4c503e09ae",
			"workers_dev": false,
			"preview_urls": false,
			"r2_buckets": [
				{
					"binding": "SNAPSHOTS",
					"bucket_name": "nvnmchain-tempo-testnet-1-snapshot",
					"remote": true
				}
			],
			"vars": {
				"R2_PUBLIC_URL": "https://snapshot.nvnm.testnet.nvnmchain.io",
				"VIEWER_ORIGIN": "https://download.nvnm.testnet.nvnmchain.io",
				"CHAIN_ID": "787223",
				"NETWORK_KEY": "nvnm-next-testnet-1",
				"NETWORK_NAME": "nvnm-next-testnet-1"
			},
			"routes": [
				{
					"pattern": "download.nvnm.testnet.nvnmchain.io",
					"custom_domain": true
				}
			],
			"triggers": {
				"crons": ["*/15 * * * *"]
			}
		}
	}
}
