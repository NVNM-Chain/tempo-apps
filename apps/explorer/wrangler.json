{
	"$schema": "https://esm.sh/wrangler/config-schema.json",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"main": "./src/index.server.ts",
	"keep_vars": true,
	"workers_dev": true,
	"preview_urls": true,
	"browser": {
		"binding": "BROWSER"
	},
	"ratelimits": [
		{
			"name": "REQUESTS_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 100,
				"period": 10
			}
		},
		{
			"name": "SIMULATE_RATE_LIMITER",
			"namespace_id": "1005",
			"simple": {
				"limit": 30,
				"period": 10
			}
		},
		{
			"name": "ASN_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 2000,
				"period": 10
			}
		},
		{
			"name": "GLOBAL_RATE_LIMITER",
			"namespace_id": "1004",
			"simple": {
				"limit": 10000,
				"period": 10
			}
		}
	],
	"env": {
		"nvnm": {
			"name": "explorer-nvnm",
			"routes": [
				{
					"custom_domain": true,
					"zone_name": "mantrachain.dev",
					"pattern": "scan.nvnm.canary.mantrachain.dev"
				}
			],
			"vars": {
				"VITE_TEMPO_ENV": "nvnm",
				"VITE_DATADOG_ENABLED": "false",
				"VITE_DATADOG_ALLOWED_TRACING_URLS": "",
				"VITE_DATADOG_ENV": "nvnm",
				"VITE_DATADOG_SERVICE": "explorer",
				"VITE_DATADOG_SESSION_REPLAY_SAMPLE_RATE": "0",
				"VITE_DATADOG_SESSION_SAMPLE_RATE": "100",
				"VITE_DATADOG_TRACE_SAMPLE_RATE": "20",
				"SENTRY_TRACES_SAMPLE_RATE": "0",
				"VITE_SENTRY_TRACES_SAMPLE_RATE": "0",
				"VITE_CONTRACT_VERIFICATION_API_BASE_URL": "https://contracts.tempo.xyz",
				"TEMPO_API_URL": "https://api.nvnm.canary.mantrachain.dev",
				"TIDX_URL": "https://api.nvnm.canary.mantrachain.dev/v1/indexer"
			},
			"browser": {
				"binding": "BROWSER"
			},
			"ratelimits": [
				{
					"name": "REQUESTS_RATE_LIMITER",
					"namespace_id": "1001",
					"simple": {
						"limit": 100,
						"period": 10
					}
				},
				{
					"name": "SIMULATE_RATE_LIMITER",
					"namespace_id": "1005",
					"simple": {
						"limit": 30,
						"period": 10
					}
				},
				{
					"name": "ASN_RATE_LIMITER",
					"namespace_id": "1003",
					"simple": {
						"limit": 2000,
						"period": 10
					}
				},
				{
					"name": "GLOBAL_RATE_LIMITER",
					"namespace_id": "1004",
					"simple": {
						"limit": 10000,
						"period": 10
					}
				}
			],
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"workers_dev": true,
			"observability": {
				"enabled": true
			}
		}
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	}
}
