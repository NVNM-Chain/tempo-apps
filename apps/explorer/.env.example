NODE_ENV="development"

# --------------------------------------------------------
# Server runtime
# --------------------------------------------------------

# Optional override for the selected chain's tidx; see NVNM.md.
# TIDX_URL=""

# Comma-separated ASNs to refuse; empty refuses none.
BLOCKED_ASNS=""

# Orchestra client_id:api_key for this Worker's network (server-only).
RPC_AUTH=""

# Optional chain 31319 gateway credentials (complete Basic authorization headers).
# Server-only: never prefix these with VITE_.
# ZONE_PROVER_RPC_AUTH=""
# ZONE_PROVER_TIDX_AUTH=""

# Optional backends for a `devnet` build pointed at another chain-31318 devnet,
# e.g. a per-devnet preview. Ignored by every other build; unset keeps the
# default devnet backends. The *_URL values are compiled into the build, from
# here or from wrangler.json's `env.devnet.vars`, never read from runtime Worker
# vars; they aren't secret. The rest are runtime secrets (server-only: never
# prefix them with VITE_). A set RPC/TIDX URL needs its complete Basic or
# Bearer authorization header, or requests fail closed.
# DEVNET_RPC_URL=""
# DEVNET_RPC_AUTH=""
# DEVNET_TIDX_URL=""
# DEVNET_TIDX_AUTH=""
# DEVNET_API_URL=""

# --------------------------------------------------------
# Client runtime (VITE_ prefix = available in browser)
# --------------------------------------------------------

VITE_BASE_URL=""

# If you need to run explorer against local contract-verification service
# you can set this to localhost
VITE_CONTRACT_VERIFICATION_API_BASE_URL="https://contracts.tempo.xyz"

# PostHog page views. Set in GitHub Actions for production builds only, so
# a local build or a clone sends nothing. Leave unset for local development.
# VITE_EXPLORER_POSTHOG_KEY=""
# VITE_POSTHOG_HOST="https://us.i.posthog.com"

# --------------------------------------------------------
# Sentry (server + client)
# --------------------------------------------------------
# SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# VITE_SENTRY_DSN=""
# VITE_SENTRY_TRACES_SAMPLE_RATE="0.1"

# --------------------------------------------------------
# Build-time only
# --------------------------------------------------------
# PORT=3007
# CLOUDFLARE_ENV="nvnm"  # nvnm | nvnm-testnet | nvnm-mainnet
# ANALYZE=false
# ANALYZE_JSON=false
# CF_PAGES_COMMIT_SHA=""

# --------------------------------------------------------
# Choose one network per build. Wrangler uses the matching environment.
# --------------------------------------------------------
# VITE_TEMPO_ENV="nvnm"  # nvnm | nvnm-testnet | nvnm-mainnet

# Show react query + react router devtools
# VITE_ENABLE_DEVTOOLS=true

# (dev/preview) comma-separated list of allowed hosts to use in vite config. See
# https://vite.dev/config/server-options
# https://vite.dev/config/preview-options#preview-allowedhosts
# ALLOWED_HOSTS=""
